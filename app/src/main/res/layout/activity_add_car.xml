<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    tools:context=".AddCarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yeni Araç Ekle"
            android:textColor="#D4AF37"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <ImageView
            android:id="@+id/imgSelected"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#222222"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <Button
            android:id="@+id/btnResimSec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:backgroundTint="#555555"
            android:text="Galeriden Resim Seç" />

        <EditText
            android:id="@+id/etMarka"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:background="#E0E0E0"
            android:hint="Marka (Örn: Audi)"
            android:paddingStart="10dp" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="#E0E0E0"
            android:hint="Model (Örn: A3 Sedan)"
            android:paddingStart="10dp" />

        <EditText
            android:id="@+id/etYil"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="#E0E0E0"
            android:hint="Yıl"
            android:inputType="number"
            android:paddingStart="10dp" />

        <EditText
            android:id="@+id/etFiyat"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="#E0E0E0"
            android:hint="Fiyat (TL)"
            android:inputType="numberDecimal"
            android:paddingStart="10dp" />

        <EditText
            android:id="@+id/etAciklama"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            android:background="#E0E0E0"
            android:gravity="top"
            android:hint="Araç Açıklaması..."
            android:padding="10dp" />

        <Button
            android:id="@+id/btnUploadCar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#D4AF37"
            android:text="İLANA KOY"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>